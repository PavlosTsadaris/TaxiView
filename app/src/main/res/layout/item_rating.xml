<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtBookingID"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/id_0000"
                    android:textColor="#1B664D"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRatingDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_12_jan_2026"
                    android:textColor="#888888"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtUserType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/badge_completed"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="@string/rated"
                android:textColor="#1B664D"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txtPickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pickup_location_rating"
                android:textColor="#333333"
                android:textSize="15sp"
                android:textStyle="bold"
                android:drawablePadding="8dp"
                app:drawableStartCompat="@android:drawable/ic_menu_mylocation"
                app:tint="#1B664D"/>

            <View
                android:layout_width="2dp"
                android:layout_height="10dp"
                android:layout_marginStart="11dp"
                android:background="#DDDDDD" />

            <TextView
                android:id="@+id/txtDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/destination_name"
                android:textColor="#333333"
                android:textSize="15sp"
                android:drawablePadding="8dp"
                app:drawableStartCompat="@android:drawable/ic_menu_mapmode"
                app:tint="#D32F2F"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <RatingBar
                android:id="@+id/ratingBarStars"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="0.5"
                android:progressTint="#FFD700" />

            <TextView
                android:id="@+id/txtNumericRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/_4_3"
                android:textColor="#666666"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtRatingComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/comment_goes_here"
            android:textColor="#555555"
            android:textSize="14sp"
            android:textStyle="italic" />

    </LinearLayout>
</androidx.cardview.widget.CardView>